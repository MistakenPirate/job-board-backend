generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  // url      = env("DATABASE_URL")
  url      = "mysql://root:password@db:3306/job_board_db" //hardcoding the docker sql link
}

model Job {
  id          Int      @id @default(autoincrement())
  title       String
  company     String
  location    String
  salary      String
  description String
  createdAt   DateTime @default(now())
}
